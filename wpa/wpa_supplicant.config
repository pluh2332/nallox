CONFIG_DRIVER_NL80211=y
CONFIG_LIBNL_TINY=y
CONFIG_TLS=openssl
CONFIG_CTRL_IFACE=y
CONFIG_BACKEND=file
CONFIG_L2_PACKET=linux
CONFIG_IEEE80211W=y
CONFIG_IEEE80211N=y
CONFIG_IEEE80211AC=y
CONFIG_SAE=y
CONFIG_OWE=y
CONFIG_PKCS12=y
CONFIG_EAP_MD5=y
CONFIG_EAP_MSCHAPV2=y
CONFIG_EAP_TLS=y
CONFIG_EAP_PEAP=y
CONFIG_EAP_TTLS=y
CONFIG_EAP_GTC=y
CONFIG_EAP_OTP=y
CFLAGS += -w -I/mnt/build/build/libnl-tiny/include -idirafter /mnt/build/build/khdr/include
LDFLAGS += -static -L/mnt/build/build/nlt
LIBS += -lnl-tiny
